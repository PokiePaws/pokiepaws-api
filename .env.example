# App
SPRING_PROFILES_ACTIVE=local
APP_PORT=9090
SERVER_PORT=9090

# Database - Postgres
POSTGRES_DB=pokiepaws
POSTGRES_USER=pokiepaws
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Administrator
ADMIN_EMAIL=admin@pokiepaws.pl
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=PokiePaws

# JWT
JWT_SECRET=replace-with-64-character-minimum-random-secret-value-1234567890abcdef
JWT_EXPIRATION=86400000

# Mail
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_DEBUG=false
MAIL_FROM=PokiePaws <no-reply@pokiepaws.local>
MAILPIT_DASHBOARD_PORT=8025
MAILPIT_SMTP_PORT=1025

# URLs
BASE_URL=http://localhost:9090
FRONTEND_URL=http://localhost:3000

# Firebase Cloud Messaging
# Set one option:
# 1) path to service account JSON inside the container
FIREBASE_SERVICE_ACCOUNT_PATH=
# 2) service account JSON encoded as Base64
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Startup jobs
DATA_INIT_ENABLED=true
VISIT_REMINDERS_ENABLED=true
VISIT_REMINDERS_SCAN_DELAY_MS=60000

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# Visits schedule
VISIT_SLOT_MINUTES=30
VISIT_WORK_START=09:00
VISIT_WORK_END=17:00

# Local seed users
DEFAULT_OWNER_PASSWORD=change-me
DEFAULT_VET_PASSWORD=change-me
DEFAULT_WORKER_PASSWORD=change-me
